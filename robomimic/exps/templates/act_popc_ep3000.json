{
    "algo_name": "act_popc",
    "experiment": {
        "name": "act_popc_robomimic",
        "validate": false,
        "logging": {
            "terminal_output_to_txt": true,
            "log_tb": true,
            "log_wandb": false,
            "wandb_proj_name": "act_popc_robomimic"
        },
        "save": {
            "enabled": true,
            "every_n_seconds": null,
            "every_n_epochs": 50,
            "epochs": [],
            "on_best_validation": false,
            "on_best_rollout_return": false,
            "on_best_rollout_success_rate": true
        },
        "epoch_every_n_steps": 100,
        "validation_epoch_every_n_steps": 10,
        "env": null,
        "additional_envs": null,
        "render": false,
        "render_video": false,
        "keep_all_videos": false,
        "video_skip": 5,
        "rollout": {
            "enabled": true,
            "n": 50,
            "horizon": 400,
            "rate": 50,
            "warmstart": 1000,
            "terminate_on_success": true
        },
        "env_meta_update_dict": {},
        "ckpt_path": null
    },
    "train": {
        "data": null,
        "output_dir": "../act_popc_trained_models",
        "normalize_weights_by_ds_size": false,
        "num_data_workers": 0,
        "hdf5_cache_mode": "low_dim",
        "hdf5_use_swmr": true,
        "hdf5_load_next_obs": false,
        "hdf5_normalize_obs": false,
        "hdf5_filter_key": null,
        "hdf5_validation_filter_key": null,
        "seq_length": 16,
        "pad_seq_length": true,
        "frame_stack": 1,
        "pad_frame_stack": true,
        "dataset_keys": [
            "actions",
            "rewards",
            "dones",
            "phase_labels"
        ],
        "action_keys": [
            "actions"
        ],
        "action_config": {
            "actions": {
                "normalization": null
            }
        },
        "goal_mode": null,
        "cuda": true,
        "batch_size": 100,
        "num_epochs": 3000,
        "seed": 1,
        "max_grad_norm": null
    },
    "algo": {
        "optim_params": {
            "policy": {
                "optimizer_type": "adamw",
                "learning_rate": {
                    "initial": 1e-05,
                    "decay_factor": 0.1,
                    "step_every_batch": true,
                    "scheduler_type": "cosine",
                    "num_cycles": 0.5,
                    "warmup_steps": 500,
                    "epoch_schedule": []
                },
                "regularization": {
                    "L2": 0.0001,
                    "max_grad_norm": 1.0
                }
            }
        },
        "phase_label":{
            "action_mode": "absolute"
        },
        "ood": {
            "enabled": true,
            "threshold": null,
            "temperature" : 1.0,
            "momentum": 0.99,
            "cov_eps":  1e-4
        },
        "phase_condition": {
            "enabled": true,
            "emb_dim": 16
        },
        "aux_head": {
            "hidden_dim": 256
        },
        "phase_head": {
            "enabled": true
        },
        "loss_weight": {
            "kl": 10.0,
            "phase_loss": 0.5,
            "aux_decay_epochs":0
        },
        "horizon": {
            "prediction_horizon": 16
        },
        "model": {
            "hidden_dim": 512,
            "dim_feedforward": 3200,
            "nheads": 8,
            "enc_layers": 4,
            "dec_layers": 7,
            "dropout": 0.1,
            "pre_norm": false,
            "backbone": "resnet18",
            "lr_backbone": 1e-05
        },
        "camera_keys": [
            "agentview_image",
            "robot0_eye_in_hand_image"
        ],
        "state_keys": [
            "robot0_eef_pos",
            "robot0_eef_quat",
            "robot0_gripper_qpos"
        ]
    },
    "observation": {
        "modalities": {
            "obs": {
                "low_dim": [
                    "robot0_eef_pos",
                    "robot0_eef_quat",
                    "robot0_gripper_qpos"
                ],
                "rgb": [
                    "agentview_image",
                    "robot0_eye_in_hand_image"
                ],
                "depth": [],
                "scan": []
            },
            "goal": {
                "low_dim": [],
                "rgb": [],
                "depth": [],
                "scan": []
            }
        },
        "encoder": {
            "low_dim": {
                "core_class": null,
